{
  "name": "acelang",
  "displayName": "Acelang - FiveM Configuration Language",
  "description": "Professional syntax highlighting and language support for FiveM .ac configuration files",
  "version": "1.0.0",
  "publisher": "acelang",
  "author": {
    "name": "Acelang Contributors"
  },
  "license": "MIT",
  "homepage": "https://github.com/n11kol11c/acelang",
  "repository": {
    "type": "git",
    "url": "https://github.com/n11kol11c/acelang.git"
  },
  "bugs": {
    "url": "https://github.com/n11kol11c/acelang/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "fivem",
    "acelang",
    "configuration",
    "syntax-highlighting",
    "game-server"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "acelang",
        "aliases": [
          "Acelang",
          "acelang",
          "FiveM Config",
          ".ac"
        ],
        "extensions": [
          ".ac"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "acelang",
        "scopeName": "source.acelang",
        "path": "./syntaxes/acelang.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
